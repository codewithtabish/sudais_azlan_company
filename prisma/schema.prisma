generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  clerkId   String    @unique
  firstName String?
  lastName  String?
  email     String?
  role      UserRole  @default(USER)
  lastSeen  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@index([clerkId])
  @@index([role])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@index([name])
}

model Project {
  id               String    @id @default(cuid())
  userId           String
  categoryId       String
  title            String
  slug             String
  shortDescription String?
  description      String?
  bannerImage      String?
  images           String[]  @default([])
  liveUrl          String?
  githubUrl        String?
  demoUrl          String?
  caseStudyUrl     String?
  technologies     String[]
  content          Json?
  featured         Boolean   @default(false)
  published        Boolean   @default(false)
  sortOrder        Int       @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  metaTitle        String?
  metaDescription  String?
  canonicalUrl     String?
  ogImageUrl       String?
  keywords         String[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  category         Category  @relation(fields: [categoryId], references: [id])
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
  @@index([categoryId])
  @@index([published])
  @@index([featured])
  @@index([sortOrder])
}

enum UserRole {
  USER
  ADMIN
}



model NewsletterSubscriber {
  id             String           @id @default(cuid())

  email          String           @unique

  status         NewsletterStatus @default(PENDING)

  subscribedAt   DateTime?
  unsubscribedAt DateTime?

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
}


// ============================================================
// NEWSLETTER STATUS
// ============================================================

enum NewsletterStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}